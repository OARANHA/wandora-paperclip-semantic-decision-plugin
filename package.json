{
  "name": "@wandora/paperclip-semantic-decision-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Advisory semantic-decision plugin for Paperclip, currently backed by TypeSafe/Jev.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OARANHA/wandora-paperclip-semantic-decision-plugin.git"
  },
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "build:rollup": "rollup -c",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm typecheck && pnpm test && pnpm build"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "wandora",
    "semantic-decision",
    "jev",
    "typesafe"
  ],
  "author": "OARANHA / Wandora contributors",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.916.0",
    "@paperclipai/shared": "2026.916.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.28.1",
    "rollup": "^4.38.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  }
}
